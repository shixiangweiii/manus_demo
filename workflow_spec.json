{
  "name": "search-and-summarize",
  "description": "搜索并汇总信息",
  "steps": [
    {
      "id": "search",
      "tool": "web_search",
      "params": {"query": "Python 3.12 new features"}
    },
    {
      "id": "fetch",
      "tool": "fetch_url",
      "params": {"url": "${search}"},
      "depends_on": ["search"]
    }
  ],
  "final_step": "fetch"
}